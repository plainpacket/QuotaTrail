<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:right="2dp" android:top="5dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#24302E29" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="28dp"
                android:bottomRightRadius="8dp" android:bottomLeftRadius="28dp" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFCF6" />
            <stroke android:width="1dp" android:color="#FFD1CBC0" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="28dp"
                android:bottomRightRadius="8dp" android:bottomLeftRadius="28dp" />
        </shape>
    </item>
</layer-list>
